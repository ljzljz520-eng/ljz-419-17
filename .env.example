# ==================== 基础配置 ====================
TZ=Asia/Shanghai
APP_DEBUG=false
LOG_LEVEL=INFO

# ==================== 服务发现与配置管理 ====================
CONSUL_ENABLED=true
CONSUL_CONFIG_PREFIX=config/user-service

# ==================== PostgreSQL HA 配置 ====================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_this_postgres_password
POSTGRES_DB=user_db
USER_DB_SCHEMA=user_service
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=change_this_replication_password
PGPOOL_ADMIN_USERNAME=pgpooladmin
PGPOOL_ADMIN_PASSWORD=change_this_pgpool_admin_password

# ==================== JWT 配置 ====================
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== Kong 配置 ====================
KONG_LOG_LEVEL=info

# ==================== gRPC 安全配置 ====================
GRPC_TLS_ENABLED=true
GRPC_MTLS_ENABLED=false

# ==================== Grafana 配置 ====================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

# ==================== 资料服务（profile-service） ====================
# 资料快照持久化文件路径（JSON 快照，重启后恢复；置空则退回纯内存模式）
# docker-compose 中固定为 /data/profiles.json（挂载 profile_data 卷），
# 本地直接运行 uvicorn 时默认 ./data/profiles.json
PROFILE_STORE_PATH=./data/profiles.json
